# Angular reference material -- regenerable via tools/fetch-angular-docs.sh,
# and someone else's licensed content. Never committed.
angular-docs/

# Analysis corpus (held-out evaluation fixture) and generated artifacts.
# INPUT/ is a vendored Angular repo including node_modules; OUTPUT/ is a scratch
# directory. Runs worth keeping get promoted to the tracked examples/ tree.
INPUT/
OUTPUT/

# Dependencies
node_modules/

# Build output
dist/
build/
target/
*.tsbuildinfo

# Caches
.cache/
.code2docs-cache/
coverage/

# Claude Code per-developer settings. settings.json IS tracked -- it carries the
# examples/ write-denial that protects promoted baselines. settings.local.json is
# one developer's accumulated permission grants and travels with nobody. Listed
# here rather than relying on a global ignore, which only exists on one machine.
.claude/settings.local.json

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.local
.env.*.local

*.zip