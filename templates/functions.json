{
  "schemaVersion": "0.2.0",
  "$comment": "DETAIL TIER for the TypeScript side (your function_dict, with comments). Keyed by symbol id so an agent can jump straight to one function without reading the rest — this is the random-access property that makes the set feel IDE-like. Usually the largest file. Each entry splits `ast` (deterministic, from the Resolver) from `doc` (LLM-written); keeping them separate is what lets `ast` stay cacheable and golden-testable while `doc` is re-tunable. Also carries forms and stream detail, which are TS-side and too voluminous for the hot tier. Strict JSON; annotations use $comment keys.",

  "unitId": "component:<path>:<ClassName>",

  "symbols": {
    "$comment": "Object keyed by symbol id, not an array — random access is the point.",
    "method:<name>": {
      "ast": {
        "id": "method:<name>",
        "name": "<name>",
        "symbolKind": "<method | accessor | constructor>",
        "visibility": "<public | protected | private>",
        "static": false,
        "isAsync": false,
        "lifecycleHook": "<ngOnInit | ngOnDestroy | ... | null>",
        "params": [
          { "name": "<param>", "type": "<TS type>", "optional": false, "defaultExpression": "<source text, or null>" }
        ],
        "returnType": "<TS type>",
        "isLeaf": true,
        "cyclomaticComplexity": 0,
        "lineCount": 0,
        "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 },
        "sourceExcerpt": "<verbatim body, or null when omitted for size>",
        "existingComments": {
          "$comment": "Comments the original developer wrote. High-signal and must never be confused with generated prose.",
          "jsDoc": "<JSDoc block text, or null>",
          "inline": ["<// TODO: handle the null case>"]
        },
        "sideEffectHints": {
          "$comment": "Syntactic detection of constructs that commonly resist a naive framework migration.",
          "touchesDom": false,
          "domApis": ["<document.querySelector>"],
          "subscribes": false,
          "usesTimers": false,
          "usesLocalOrSessionStorage": false,
          "navigates": false,
          "mutatesInjectedServiceState": false,
          "throws": false,
          "hasTryCatch": false
        }
      },
      "doc": {
        "$comment": "Explainer output. Written in execution order (leaf-first) so callees are already explained. Prose is stored finished, so requirement.md rendering is mechanical assembly rather than a second LLM pass.",
        "explanation": "<plain-language description of what this does and why>",
        "order": 0,
        "consumes": ["field:<name>", "input:<name>", "dep:<propertyName>"],
        "produces": ["field:<name>", "output:<name>"],
        "sideEffects": ["<navigates to the list route on success>"],
        "edgeCases": ["<no-ops when the form is invalid>"],
        "isTrivial": false,
        "batchedWith": ["method:<otherName>"],
        "confidence": "<high | medium | low>",
        "evidence": ["method:<name>", "test:<n>"],
        "explainerVersion": "<prompt/model version; part of this tier's cache key>"
      }
    }
  },

  "forms": {
    "approach": "<reactive | template-driven | mixed | none>",
    "groups": [
      {
        "id": "form:<fieldName>",
        "name": "<fieldName>",
        "builtWith": "<FormBuilder | new FormGroup | none>",
        "controls": [
          {
            "path": "<dot.path.to.control>",
            "type": "<control | group | array>",
            "valueType": "<TS type>",
            "initialValueExpression": "<source text, or null>",
            "syncValidators": ["<required>", "<maxLength(50)>"],
            "asyncValidators": ["<uniqueLoginValidator>"],
            "disabledExpression": "<source text, or null>",
            "updateOn": "<change | blur | submit | null>",
            "boundTo": "tpl:<bindingId>"
          }
        ],
        "crossFieldValidators": ["<passwordsMatch>"],
        "submitHandler": "method:<name>",
        "resetHandler": "method:<name>",
        "patchedBy": ["method:<name>"],
        "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
      }
    ],
    "ngModelBindings": ["tpl:<bindingId>"]
  },

  "streams": [
    {
      "id": "stream:<name>",
      "name": "<name>",
      "declaredType": "<Observable<Foo>>",
      "sourceExpression": "<source text, truncated>",
      "operators": ["<switchMap>", "<catchError>"],
      "multicast": false,
      "consumedBy": ["method:<name>", "tpl:<bindingId>"],
      "consumption": "<explicit-subscribe | async-pipe | toSignal | firstValueFrom | none>",
      "unsubscribeStrategy": "<takeUntilDestroyed | Subscription.unsubscribe | take/first | none>",
      "leakRisk": "<none | possible | likely>",
      "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 },
      "doc": { "explanation": "<what this stream represents and when it emits>", "confidence": "<high | medium | low>" }
    }
  ],

  "signals": [
    { "id": "field:<name>", "signalKind": "<signal | computed | linkedSignal | toSignal>", "dependsOn": ["field:<name>"], "writtenBy": ["method:<name>"] }
  ],

  "tests": {
    "$comment": "Behavioral ground truth. The one place the codebase states intent rather than mechanism, so it both grounds explanations and contradicts wrong ones.",
    "files": ["<foo.component.spec.ts>"],
    "framework": "<jest | jasmine-karma | vitest | unknown>",
    "cases": [
      {
        "id": "test:<n>",
        "suitePath": ["<FooComponent>", "<save>"],
        "title": "<should call service on submit>",
        "targets": ["method:<name>"],
        "mocks": ["dep:<propertyName>"],
        "isSkipped": false,
        "loc": { "file": "<foo.component.spec.ts>", "line": 0, "endLine": 0 }
      }
    ]
  },

  "coverage": {
    "symbolsTotal": 0,
    "symbolsExplained": 0,
    "symbolsTrivialSkipped": 0
  },

  "provenance": {
    "$comment": "Two cache keys, because the tiers invalidate independently: editing source invalidates ast; changing the prompt or model invalidates doc only.",
    "astInputHash": "<hash of unit input files + resolverVersion>",
    "docInputHash": "<astInputHash + explainerVersion>",
    "resolverVersion": "<semver>",
    "explainerModel": "<model id>",
    "generatedAt": "<ISO-8601 UTC>"
  }
}
