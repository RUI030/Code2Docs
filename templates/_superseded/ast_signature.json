{
  "component_metadata": {
    "class_name": "String", // The name of the Angular class
    "selector": "String"    // The HTML tag used to render it
  },
  "props": {
    "inputs": [],           // Array of properties marked with @Input()
    "outputs": []           // Array of EventEmitters marked with @Output()
  },
  "dependencies": {
    "injected_services": [] // Services injected via the constructor
  },
  "state_and_variables": {
    "rxjs_streams": [],     // Variables typed as Observable, Subject, or ending in '$'
    "primitives": []        // Standard local variables (booleans, strings, etc.)
  },
  "lifecycle_hooks": [],    // Array of implemented Angular lifecycles (e.g., ngOnInit)
  "template_bindings": {
    "structural": [],       // *ngIf, *ngFor, *ngSwitch found in the HTML
    "two_way": [],          // [(ngModel)] or custom two-way bindings
    "events": []            // (click), (submit), etc. mapped to class methods
  }
}