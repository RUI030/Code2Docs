{
  "$schema": "./metadata.schema.json",
  "schemaVersion": "0.1.0",

  "$comment": "TEMPLATE. One metadata.json per analyzed unit (component, service, directive, pipe, guard, ...). Every array below shows exactly ONE representative entry to document its element shape; real output contains 0..n. Placeholders are written as <angle-brackets>. Two rules govern this file: (1) `extracted` is DETERMINISTIC — produced only by the Resolver tool from the AST, contains no LLM output, and must be byte-reproducible from unchanged source; (2) `inferred` is LLM output and every entry must cite `evidence` referring to ids or locations inside `extracted`. Sections not applicable to the unit kind are omitted entirely, never left as empty scaffolding.",

  "generator": {
    "tool": "code2docs",
    "toolVersion": "<semver>",
    "resolverVersion": "<semver of tools/ng-ast>",
    "generatedAt": "<ISO-8601 UTC>",
    "sourceRevision": "<git sha of the analyzed repo, or null>",
    "models": {
      "explainer": "<model id>",
      "synthesizer": "<model id>"
    },
    "runId": "<uuid, groups all units from one orchestrator run>"
  },

  "unit": {
    "id": "component:<path/from/app/root>:<ClassName>",
    "kind": "component",
    "kindEnum": ["component", "service", "directive", "pipe", "guard", "interceptor", "route-resolver", "module", "model", "store", "util", "unknown"],
    "className": "<ClassName>",
    "selector": "<app-foo, or null for non-component/directive>",
    "path": "<dir relative to the Angular source root>",
    "files": {
      "typescript": "<foo.component.ts>",
      "template": "<foo.component.html, or null when inline>",
      "templateInline": false,
      "styles": ["<foo.component.scss>"],
      "specs": ["<foo.component.spec.ts>"],
      "siblings": ["<other files in the unit folder not otherwise classified>"]
    },
    "standalone": true,
    "declaredInModule": "<ModuleName, or null when standalone>",
    "exported": true,
    "angularVersion": "<detected major, e.g. 17>"
  },

  "extracted": {
    "$comment": "Deterministic AST facts. This block is exactly what the Resolver returns (a.k.a. ast_signatures.json) and is cacheable/diffable independent of any LLM.",

    "decorator": {
      "type": "Component",
      "changeDetection": "<Default | OnPush | null>",
      "encapsulation": "<Emulated | None | ShadowDom | null>",
      "providers": ["<TokenName>"],
      "imports": ["<StandaloneImportName>"],
      "hostDirectives": ["<DirectiveName>"],
      "animations": ["<triggerName>"],
      "hasPreserveWhitespaces": false
    },

    "publicApi": {
      "inputs": [
        {
          "id": "input:<propertyName>",
          "name": "<propertyName>",
          "alias": "<template-facing name, or null>",
          "type": "<declared TS type as written>",
          "required": false,
          "hasDefault": true,
          "defaultExpression": "<source text of the initializer, truncated>",
          "declarationStyle": "<decorator | signal | setter>",
          "transform": "<transform fn name, or null>",
          "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
        }
      ],
      "outputs": [
        {
          "id": "output:<propertyName>",
          "name": "<propertyName>",
          "alias": "<template-facing name, or null>",
          "payloadType": "<T in EventEmitter<T>>",
          "declarationStyle": "<eventemitter | output-fn | subject>",
          "emittedFrom": ["method:<methodName>"],
          "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
        }
      ],
      "twoWayBindings": [
        {
          "id": "model:<propertyName>",
          "name": "<propertyName>",
          "type": "<T in model<T>()>",
          "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
        }
      ],
      "publicMethods": ["method:<methodName>"],
      "templateReachableMembers": ["field:<name>", "method:<name>"]
    },

    "dependencyInjection": [
      {
        "id": "dep:<propertyName>",
        "propertyName": "<propertyName>",
        "token": "<ServiceClass | InjectionTokenName | string literal>",
        "resolvedUnitId": "<service:...:ClassName, or null when external to the repo>",
        "origin": "<angular | rxjs | third-party | internal>",
        "injectionStyle": "<constructor-param | inject-fn>",
        "modifiers": {
          "optional": false,
          "self": false,
          "skipSelf": false,
          "host": false
        },
        "usedBy": ["method:<methodName>"],
        "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
      }
    ],

    "viewQueries": [
      {
        "id": "query:<propertyName>",
        "propertyName": "<propertyName>",
        "queryType": "<ViewChild | ViewChildren | ContentChild | ContentChildren>",
        "declarationStyle": "<decorator | signal>",
        "selector": "<template ref name | ComponentClass | DirectiveClass>",
        "read": "<read token, or null>",
        "static": false,
        "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
      }
    ],

    "host": {
      "bindings": [
        { "id": "hostbind:<n>", "attribute": "<class.active | attr.role | style.width>", "expression": "<source text>", "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 } }
      ],
      "listeners": [
        { "id": "hostlisten:<n>", "event": "<document:click>", "handler": "<source text>", "args": ["$event"], "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 } }
      ]
    },

    "classMembers": {
      "fields": [
        {
          "id": "field:<name>",
          "name": "<name>",
          "type": "<declared or inferred TS type>",
          "visibility": "<public | protected | private>",
          "static": false,
          "readonly": false,
          "initializerExpression": "<source text, truncated>",
          "roleHints": {
            "$comment": "Syntactic classification only — no semantic judgement. Semantics belong in inferred.stateModel.",
            "isSignal": false,
            "signalKind": "<signal | computed | linkedSignal | toSignal | null>",
            "isRxjs": false,
            "rxjsKind": "<Observable | Subject | BehaviorSubject | ReplaySubject | Subscription | null>",
            "isFormEntity": false,
            "formKind": "<FormGroup | FormControl | FormArray | FormRecord | null>",
            "isConstant": false
          },
          "readBy": ["method:<name>", "tpl:<bindingId>"],
          "writtenBy": ["method:<name>"],
          "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
        }
      ],
      "accessors": [
        {
          "id": "accessor:<name>",
          "name": "<name>",
          "accessorKind": "<get | set>",
          "type": "<TS type>",
          "dependsOnFields": ["field:<name>"],
          "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
        }
      ],
      "methods": [
        {
          "id": "method:<name>",
          "name": "<name>",
          "visibility": "<public | protected | private>",
          "static": false,
          "isAsync": false,
          "isGenerator": false,
          "lifecycleHook": "<ngOnInit | ngOnChanges | ngOnDestroy | ngAfterViewInit | ... | null>",
          "params": [
            { "name": "<param>", "type": "<TS type>", "optional": false, "defaultExpression": "<source text, or null>" }
          ],
          "returnType": "<TS type>",
          "callsLocal": ["method:<name>"],
          "callsInjected": [
            { "dep": "dep:<propertyName>", "member": "<methodName>", "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 } }
          ],
          "readsFields": ["field:<name>"],
          "writesFields": ["field:<name>"],
          "emits": ["output:<name>"],
          "sideEffectHints": {
            "$comment": "Syntactic detection of constructs that commonly resist a naive framework migration.",
            "touchesDom": false,
            "domApis": ["<document.querySelector>"],
            "subscribes": false,
            "usesTimers": false,
            "usesLocalOrSessionStorage": false,
            "navigates": false,
            "mutatesInjectedServiceState": false,
            "throws": false,
            "hasTryCatch": false
          },
          "isLeaf": true,
          "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
        }
      ]
    },

    "lifecycle": {
      "implementedHooks": ["<ngOnInit>"],
      "declaredInterfaces": ["<OnInit>"],
      "constructorDoesWork": false,
      "hasCleanup": true,
      "cleanupStrategy": "<ngOnDestroy-unsubscribe | takeUntilDestroyed | DestroyRef | async-pipe-only | none>"
    },

    "callGraph": {
      "$comment": "In-file graph over methods/accessors. executionOrder is a leaf-first topological order and is the sequence the Explainer must follow.",
      "nodes": ["method:<name>"],
      "edges": [{ "from": "method:<caller>", "to": "method:<callee>" }],
      "entryPoints": ["method:<ngOnInit>", "tpl-handler:<bindingId>"],
      "executionOrder": ["method:<leafFirst>"],
      "cycles": [["method:<a>", "method:<b>"]],
      "unreachableMethods": ["method:<name>"]
    },

    "reactiveState": {
      "signals": [
        { "id": "field:<name>", "signalKind": "<signal | computed | linkedSignal | toSignal>", "dependsOn": ["field:<name>"], "writtenBy": ["method:<name>"] }
      ],
      "streams": [
        {
          "id": "stream:<fieldOrLocalName>",
          "name": "<name>",
          "declaredType": "<Observable<Foo>>",
          "sourceExpression": "<source text, truncated>",
          "operators": ["<switchMap>", "<catchError>"],
          "multicast": false,
          "consumedBy": ["method:<name>", "tpl:<bindingId>"],
          "consumption": "<explicit-subscribe | async-pipe | toSignal | firstValueFrom | none>",
          "unsubscribeStrategy": "<takeUntilDestroyed | Subscription.unsubscribe | take/first | none>",
          "leakRisk": "<none | possible | likely>",
          "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
        }
      ],
      "subscriptions": [
        { "id": "sub:<n>", "stream": "stream:<name>", "inMethod": "method:<name>", "storedIn": "field:<name>", "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 } }
      ]
    },

    "forms": {
      "approach": "<reactive | template-driven | mixed | none>",
      "groups": [
        {
          "id": "form:<fieldName>",
          "name": "<fieldName>",
          "builtWith": "<FormBuilder | new FormGroup | none>",
          "controls": [
            {
              "path": "<dot.path.to.control>",
              "type": "<control | group | array>",
              "valueType": "<TS type>",
              "initialValueExpression": "<source text, or null>",
              "syncValidators": ["<required>", "<maxLength(50)>"],
              "asyncValidators": ["<uniqueLoginValidator>"],
              "disabledExpression": "<source text, or null>",
              "updateOn": "<change | blur | submit | null>"
            }
          ],
          "crossFieldValidators": ["<passwordsMatch>"],
          "submitHandler": "method:<name>",
          "resetHandler": "method:<name>",
          "patchedBy": ["method:<name>"],
          "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
        }
      ],
      "ngModelBindings": ["tpl:<bindingId>"]
    },

    "template": {
      "$comment": "Parsed from the component's HTML (external file or inline). Every node carries a stable tpl:<id> so inferred.uiRequirements can cite it.",
      "parseStatus": "<ok | partial | failed>",
      "parseDiagnostics": ["<message>"],
      "rootElementCount": 0,
      "controlFlow": [
        {
          "id": "tpl:<id>",
          "construct": "<@if | @else-if | @else | @for | @empty | @switch | @case | *ngIf | *ngFor | ngSwitch>",
          "expression": "<condition or iterable expression as written>",
          "itemAlias": "<loop variable, or null>",
          "trackBy": "<track expression or trackBy fn, or null>",
          "aliases": ["<$index>", "<as vm>"],
          "dependsOn": ["field:<name>", "accessor:<name>"],
          "parent": "tpl:<id or null>",
          "loc": { "file": "<foo.component.html>", "line": 0, "endLine": 0 }
        }
      ],
      "propertyBindings": [
        { "id": "tpl:<id>", "target": "<element or component selector>", "property": "<disabled | [ngClass] | src>", "bindingKind": "<property | attribute | class | style | animation>", "expression": "<source text>", "dependsOn": ["field:<name>"], "loc": { "file": "<foo.component.html>", "line": 0, "endLine": 0 } }
      ],
      "eventBindings": [
        { "id": "tpl:<id>", "target": "<element or component selector>", "event": "<click | keydown.enter | customOutput>", "handlerExpression": "<source text>", "handlerMethod": "method:<name or null>", "passesEvent": false, "loc": { "file": "<foo.component.html>", "line": 0, "endLine": 0 } }
      ],
      "twoWayBindings": [
        { "id": "tpl:<id>", "target": "<element>", "property": "<ngModel | value>", "expression": "<source text>", "loc": { "file": "<foo.component.html>", "line": 0, "endLine": 0 } }
      ],
      "interpolations": [
        { "id": "tpl:<id>", "expression": "<source text>", "pipes": ["<translate>", "<date:'short'>"], "dependsOn": ["field:<name>"], "loc": { "file": "<foo.component.html>", "line": 0, "endLine": 0 } }
      ],
      "childComponents": [
        { "id": "tpl:<id>", "selector": "<app-child>", "resolvedUnitId": "<component:...:ChildComponent, or null>", "inputsPassed": [{ "name": "<childInput>", "expression": "<source text>" }], "outputsHandled": [{ "name": "<childOutput>", "handlerExpression": "<source text>" }], "loc": { "file": "<foo.component.html>", "line": 0, "endLine": 0 } }
      ],
      "directivesUsed": [
        { "selector": "<appHighlight | routerLink | ngbTooltip>", "origin": "<angular | third-party | internal>", "resolvedUnitId": "<directive:... or null>", "inputsPassed": [{ "name": "<x>", "expression": "<source text>" }] }
      ],
      "pipesUsed": [
        { "name": "<translate>", "origin": "<angular | third-party | internal>", "resolvedUnitId": "<pipe:... or null>", "isPure": true, "args": ["<source text>"] }
      ],
      "templateRefs": [
        { "id": "tpl:<id>", "name": "<#myRef>", "onElement": "<element or component selector>", "referencedBy": ["query:<propertyName>", "tpl:<id>"] }
      ],
      "ngTemplates": [
        { "id": "tpl:<id>", "name": "<#tmplName>", "contextKeys": ["<key>"], "instantiatedBy": ["tpl:<id>"] }
      ],
      "contentProjection": [
        { "id": "tpl:<id>", "select": "<[header] | null for default slot>" }
      ],
      "accessibility": [
        { "id": "tpl:<id>", "target": "<element>", "attributes": { "role": "<button>", "aria-label": "<source text>" } }
      ],
      "i18n": [
        { "id": "tpl:<id>", "mechanism": "<i18n-attr | translate-pipe | translate-directive>", "key": "<translation.key>", "params": ["<paramName>"] }
      ],
      "rawHtmlSinks": [
        { "id": "tpl:<id>", "property": "<innerHTML>", "expression": "<source text>", "sanitizerBypassed": false }
      ]
    },

    "styles": {
      "files": ["<foo.component.scss>"],
      "inlineStyleCount": 0,
      "usesViewEncapsulationEscapes": false,
      "escapeSelectors": ["<::ng-deep .foo>"],
      "usesHostSelectors": false,
      "importsGlobalStyles": ["<../../shared.scss>"],
      "classesReferencedFromTs": ["<is-active>"]
    },

    "routing": {
      "isRoutedComponent": true,
      "routePaths": ["<entity/foo/:id/edit>"],
      "routeParamsConsumed": [
        { "name": "<id>", "access": "<snapshot | observable | withComponentInputBinding>", "inMethod": "method:<name>" }
      ],
      "queryParamsConsumed": [{ "name": "<page>", "access": "<snapshot | observable>" }],
      "routeDataConsumed": ["<resolvedFoo>"],
      "navigations": [
        { "id": "nav:<n>", "api": "<router.navigate | navigateByUrl | routerLink>", "targetExpression": "<source text>", "from": "method:<name> | tpl:<id>", "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 } }
      ],
      "guards": ["<guard:...:AuthGuard>"],
      "resolvers": ["<route-resolver:...:FooResolver>"]
    },

    "httpInteractions": [
      {
        "id": "http:<n>",
        "method": "<GET | POST | PUT | PATCH | DELETE>",
        "urlExpression": "<source text, e.g. `${this.resourceUrl}/${id}`>",
        "requestType": "<TS type, or null>",
        "responseType": "<TS type, or null>",
        "viaDependency": "dep:<propertyName>",
        "calledFrom": "method:<name>",
        "directHttpClientUse": false,
        "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
      }
    ],

    "imports": {
      "angular": [{ "module": "<@angular/core>", "symbols": ["<Component>", "<inject>"] }],
      "rxjs": [{ "module": "<rxjs/operators>", "symbols": ["<switchMap>"] }],
      "thirdParty": [{ "module": "<@ng-bootstrap/ng-bootstrap>", "symbols": ["<NgbModal>"] }],
      "internal": [{ "module": "<app/shared/foo.model>", "symbols": ["<IFoo>"], "resolvedUnitId": "<model:...:IFoo, or null>" }],
      "unresolved": ["<module specifier the resolver could not classify>"]
    },

    "dataTypes": [
      {
        "id": "type:<Name>",
        "name": "<Name>",
        "declarationKind": "<interface | type-alias | class | enum>",
        "definedHere": false,
        "sourceUnitId": "<model:...:IFoo, or null>",
        "shape": [
          { "name": "<field>", "type": "<TS type>", "optional": false, "nullable": false, "isEnum": false, "enumValues": ["<A>"] }
        ],
        "usedIn": ["input:<name>", "method:<name>", "form:<name>"]
      }
    ],

    "tests": {
      "files": ["<foo.component.spec.ts>"],
      "framework": "<jest | jasmine-karma | vitest | unknown>",
      "cases": [
        {
          "id": "test:<n>",
          "suitePath": ["<FooComponent>", "<save>"],
          "title": "<should call service on submit>",
          "targets": ["method:<name>"],
          "mocks": ["dep:<propertyName>"],
          "isSkipped": false,
          "loc": { "file": "<foo.component.spec.ts>", "line": 0, "endLine": 0 }
        }
      ]
    },

    "metrics": {
      "tsLineCount": 0,
      "templateLineCount": 0,
      "methodCount": 0,
      "publicApiSurface": 0,
      "maxCyclomaticComplexity": 0,
      "maxTemplateNestingDepth": 0,
      "injectedDependencyCount": 0
    }
  },

  "inferred": {
    "$comment": "LLM output (Explainer + Requirements Synthesizer). Describes EXISTING behavior in framework-independent terms; it must not prescribe a target-framework architecture. Every entry cites `evidence` — ids or locs from `extracted` — so a reviewer can check any claim against source.",

    "purpose": "<one sentence: what this unit exists to do, in domain language>",
    "responsibilities": [
      { "id": "resp:<n>", "statement": "<a distinct responsibility>", "evidence": ["method:<name>", "tpl:<id>"] }
    ],
    "domainConcepts": [
      { "term": "<domain noun>", "meaning": "<what it denotes in this system>", "evidence": ["type:<Name>"] }
    ],

    "functionExplanations": [
      {
        "$comment": "One entry per method/accessor, ordered by extracted.callGraph.executionOrder. Produced by the Explainer.",
        "symbol": "method:<name>",
        "order": 0,
        "explanation": "<plain-language description of what this does and why>",
        "consumes": ["field:<name>", "input:<name>", "dep:<propertyName>"],
        "produces": ["field:<name>", "output:<name>"],
        "sideEffects": ["<navigates to the list route on success>"],
        "edgeCases": ["<no-ops when the form is invalid>"],
        "confidence": "<high | medium | low>"
      }
    ],

    "stateModel": {
      "external": [{ "id": "state:<n>", "name": "<name>", "owner": "dep:<propertyName>", "description": "<what it holds>", "evidence": ["dep:<propertyName>"] }],
      "local": [{ "id": "state:<n>", "name": "field:<name>", "description": "<what it holds>", "mutatedBy": ["method:<name>"], "evidence": ["field:<name>"] }],
      "derived": [{ "id": "state:<n>", "name": "<name>", "derivedFrom": ["field:<name>"], "rule": "<how it is computed>", "evidence": ["accessor:<name>"] }],
      "form": [{ "id": "state:<n>", "form": "form:<name>", "description": "<what the form captures>", "validationRules": ["<login is required, 1-50 chars>"], "evidence": ["form:<name>"] }],
      "async": [{ "id": "state:<n>", "name": "stream:<name>", "trigger": "<what starts it>", "loadingIndicator": "field:<name> | null", "errorHandling": "<what happens on failure>", "evidence": ["stream:<name>"] }]
    },

    "workflows": [
      {
        "id": "flow:<n>",
        "name": "<Save an edited record>",
        "trigger": "<user submits the form | ngOnInit | parent changes input X>",
        "preconditions": ["<form is valid>"],
        "steps": [
          { "order": 0, "action": "<what happens>", "evidence": ["method:<name>"] }
        ],
        "successOutcome": "<observable end state>",
        "failureOutcomes": ["<condition -> resulting state>"],
        "evidence": ["method:<name>", "tpl:<id>"]
      }
    ],

    "uiRequirements": [
      {
        "id": "ui:<n>",
        "category": "<visibility | list | text | form | interaction | loading | error | navigation | accessibility | i18n>",
        "statement": "<framework-independent requirement, e.g. 'The delete button is shown only when the user has ROLE_ADMIN.'>",
        "evidence": ["tpl:<id>"]
      }
    ],

    "behavioralInvariants": [
      { "id": "inv:<n>", "statement": "<must always hold after migration>", "whyItMatters": "<consequence if violated>", "evidence": ["method:<name>", "test:<n>"] }
    ],

    "publicContract": {
      "$comment": "Prose restatement of extracted.publicApi from the consumer's point of view.",
      "consumedBy": ["<component:...:ParentComponent>"],
      "inputContracts": [{ "input": "input:<name>", "meaning": "<what the parent is expected to pass>", "requiredness": "<required | optional-with-default>", "evidence": ["input:<name>"] }],
      "outputContracts": [{ "output": "output:<name>", "meaning": "<what the parent should do on this event>", "emittedWhen": "<condition>", "evidence": ["output:<name>"] }]
    },

    "suggestedDecomposition": [
      { "id": "split:<n>", "proposedUnit": "<name of a separable responsibility>", "rationale": "<why it is separable>", "coveredMembers": ["method:<name>", "field:<name>"] }
    ],

    "coverageAssessment": {
      "membersExplained": 0,
      "membersTotal": 0,
      "templateNodesCovered": 0,
      "templateNodesTotal": 0,
      "overallConfidence": "<high | medium | low>"
    }
  },

  "migration": {
    "$comment": "Framework-agnostic hazards. Names the Angular-specific assumption at risk, not the target-framework fix.",
    "risks": [
      {
        "id": "risk:<n>",
        "category": "<rxjs-pipeline | mutable-service-state | direct-dom-access | lifecycle-ordering | di-assumption | change-detection | forms-semantics | style-encapsulation | template-directive | routing | third-party-dependency | subscription-leak | security>",
        "severity": "<high | medium | low>",
        "description": "<the Angular-specific behavior that will not carry over verbatim>",
        "behaviorAtRisk": "<the observable behavior that could silently change>",
        "evidence": ["method:<name>", "stream:<name>", "tpl:<id>"],
        "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 }
      }
    ],
    "thirdPartyDependencies": [
      { "package": "<@ng-bootstrap/ng-bootstrap>", "usedFor": "<modal dialogs>", "hasDirectEquivalent": "<unknown>", "evidence": ["dep:<propertyName>"] }
    ]
  },

  "review": {
    "$comment": "The human gate. Stage 2 must not start while status is 'pending' or any blocking question is open.",
    "status": "<pending | approved | changes-requested>",
    "openQuestions": [
      { "id": "q:<n>", "question": "<what the tool could not determine>", "blocking": true, "evidence": ["method:<name>"] }
    ],
    "suspectedDefects": [
      { "id": "bug:<n>", "description": "<apparent bug in the existing Angular code>", "confidence": "<high | medium | low>", "evidence": ["method:<name>"], "loc": { "file": "<foo.component.ts>", "line": 0, "endLine": 0 } }
    ],
    "resolverWarnings": ["<file could not be fully parsed: ...>"],
    "unresolvedReferences": ["<symbol or selector the resolver could not link to a unit>"],
    "reviewedBy": "<name, or null>",
    "reviewedAt": "<ISO-8601 UTC, or null>",
    "requirementDocPath": "<relative path to the generated requirement.md>"
  }
}
