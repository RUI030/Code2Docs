{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2docs/schema/signature.schema.json",
  "title": "signature.json -- hot tier",
  "$comment": "Answers 'what is this?'. 100% deterministic: no LLM output, byte-reproducible from unchanged source. additionalProperties is false throughout, because a typo in an emitted field name would otherwise pass silently and the field would simply never be read. [tier] HOT TIER \u2014 the first and often only file an agent reads. Answers 'what is this?'. Keep it small enough to read whole without regret; push anything voluminous into the other tiers and reference it by id. Every array shows ONE representative entry to document element shape. Strict JSON only: annotations use $comment keys, never // comments.",
  "type": "object",
  "required": [
    "schemaVersion",
    "unit",
    "manifest",
    "publicApi",
    "injectedDependencies",
    "lifecycle",
    "stateOutline",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.4.0",
      "$comment": "0.4.0 makes provenance.warnings structured objects with a closed code vocabulary and requires a computed parseStatus; 0.3.0 carried free prose that mixed designed gaps with real degradations, so nothing downstream could tell them apart."
    },
    "unit": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "className",
        "path",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/unitId"
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/unitKind"
        },
        "className": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "selector": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "standalone": {
          "type": "boolean"
        },
        "declaredInModule": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "isDefaultExport": {
          "type": "boolean"
        },
        "siblings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "object",
          "required": [
            "typescript"
          ],
          "additionalProperties": false,
          "properties": {
            "typescript": {
              "type": "string",
              "minLength": 1
            },
            "template": {
              "$ref": "common.schema.json#/$defs/nullableString"
            },
            "templateInline": {
              "type": "boolean"
            },
            "styles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "specs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "patternProperties": {
            "^\\$comment": {
              "type": "string"
            }
          }
        }
      },
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      }
    },
    "manifest": {
      "$comment": "Null means the tier was not produced for this unit -- a Phase A run produces only some of them. Pointers so one cheap read tells an agent what exists and where to look next. Null means the tier was not produced for this unit.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "functions": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "template": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "analysis": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "requirement": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "migrationNotes": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "repoIndex": {
          "$ref": "common.schema.json#/$defs/nullableString"
        }
      },
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      }
    },
    "publicApi": {
      "type": "object",
      "required": [
        "inputs",
        "outputs",
        "publicMethods"
      ],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "type",
              "loc"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^input:[A-Za-z_$][A-Za-z0-9_$]*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "alias": {
                "$ref": "common.schema.json#/$defs/nullableString"
              },
              "type": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "defaultExpression": {
                "$ref": "common.schema.json#/$defs/nullableString"
              },
              "declarationStyle": {
                "type": "string",
                "enum": [
                  "decorator",
                  "signal",
                  "setter"
                ]
              },
              "transform": {
                "$ref": "common.schema.json#/$defs/nullableString"
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            },
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "loc"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^output:[A-Za-z_$][A-Za-z0-9_$]*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "alias": {
                "$ref": "common.schema.json#/$defs/nullableString"
              },
              "payloadType": {
                "type": "string"
              },
              "declarationStyle": {
                "type": "string",
                "enum": [
                  "eventemitter",
                  "output-fn",
                  "subject",
                  "outputFromObservable"
                ],
                "$comment": "'outputFromObservable' (from @angular/core/rxjs-interop) is an output DRIVEN BY A STREAM, so it is simultaneously a public-contract entry and a teardown concern -- the subscription is managed by the framework, which is exactly the kind of thing a naive rewrite reimplements by hand and leaks. emittedFrom names the stream it wraps when that stream is a named field."
              },
              "emittedFrom": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/memberId"
                }
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            },
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            }
          }
        },
        "twoWayBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^model:[A-Za-z_$][A-Za-z0-9_$]*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "type": {
                "type": "string"
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            },
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            }
          }
        },
        "publicMethods": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/memberId"
          }
        },
        "templateReachableMembers": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/memberId"
          }
        }
      },
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "$comment": "Full detail lives here \u2014 it is small, hot, and the most-asked question about any component."
    },
    "injectedDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "propertyName",
          "token",
          "origin",
          "injectionStyle"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dep:[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "propertyName": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "token": {
            "type": "string",
            "minLength": 1
          },
          "resolvedUnitId": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/unitId"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "angular",
              "rxjs",
              "third-party",
              "internal"
            ]
          },
          "injectionStyle": {
            "type": "string",
            "enum": [
              "constructor-param",
              "inject-fn"
            ]
          },
          "modifiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "optional": {
                "type": "boolean"
              },
              "self": {
                "type": "boolean"
              },
              "skipSelf": {
                "type": "boolean"
              },
              "host": {
                "type": "boolean"
              }
            },
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            }
          },
          "loc": {
            "$ref": "common.schema.json#/$defs/loc"
          },
          "effectivelyUnused": {
            "$comment": "True when the dependency is injected but reachable only from unreachable code (F4). Distinct from simply unused: the injection is real, the usage is dead.",
            "type": "boolean"
          },
          "visibility": {
            "$comment": "private/protected/public on the injected member. Found missing by the di fixture pair: a protected dependency is reachable from the template and a private one is not, so dropping it loses a real constraint on a rewrite.",
            "type": "string",
            "enum": [
              "public",
              "protected",
              "private"
            ]
          }
        },
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        }
      },
      "$comment": "Identity only. Call sites and usage live in dependencies.json."
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "implementedHooks",
        "cleanupStrategy"
      ],
      "additionalProperties": false,
      "properties": {
        "implementedHooks": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "declaredInterfaces": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        },
        "constructorDoesWork": {
          "type": "boolean"
        },
        "cleanupStrategy": {
          "type": "string",
          "enum": [
            "ngOnDestroy-unsubscribe",
            "takeUntilDestroyed",
            "DestroyRef",
            "async-pipe-only",
            "none"
          ]
        },
        "fieldInitializerDoesWork": {
          "$comment": "A field initializer that calls a service runs during construction, before ngOnInit, creating an ordering requirement a rewrite can silently break.",
          "type": "boolean"
        }
      },
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      }
    },
    "stateOutline": {
      "type": "object",
      "required": [
        "fields",
        "methodIds"
      ],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "visibility",
              "loc"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^field:[A-Za-z_$][A-Za-z0-9_$]*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "type": {
                "type": "string"
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "protected",
                  "private"
                ]
              },
              "readonly": {
                "type": "boolean"
              },
              "initializerExpression": {
                "$ref": "common.schema.json#/$defs/nullableString"
              },
              "roleHints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "isSignal": {
                    "type": "boolean"
                  },
                  "signalKind": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "signal",
                      "computed",
                      "linkedSignal",
                      "toSignal",
                      null
                    ]
                  },
                  "isRxjs": {
                    "type": "boolean"
                  },
                  "rxjsKind": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "Observable",
                      "Subject",
                      "BehaviorSubject",
                      "ReplaySubject",
                      "Subscription",
                      null
                    ]
                  },
                  "isFormEntity": {
                    "type": "boolean"
                  },
                  "formKind": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "FormGroup",
                      "FormControl",
                      "FormArray",
                      "FormRecord",
                      null
                    ],
                    "$comment": "A role HINT about the TYPE a field holds, which is a different question from what kind of control a node in the form tree is -- functions.json#/forms/groups/controls/type is authoritative for that. Both list FormRecord/record; neither is derived from the other, so the relationship is stated here rather than left for a reader to infer (F10e)."
                  },
                  "isConstant": {
                    "type": "boolean"
                  }
                },
                "patternProperties": {
                  "^\\$comment": {
                    "type": "string"
                  }
                }
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              },
              "isArrowFunctionProperty": {
                "$comment": "Arrow-function class property rather than a method: `this` is bound at construction, which a naive port to a method changes.",
                "type": "boolean"
              }
            },
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            }
          }
        },
        "methodIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/memberId"
          }
        },
        "accessorIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/memberId"
          }
        },
        "formIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/memberId"
          }
        },
        "streamIds": {
          "$comment": "Source-named streams only (D12a). A chain built and subscribed inline has no name in source, gets no id, and is recorded as an attribute of the subscribing symbol instead -- see functions.symbols[].ast.subscriptions.",
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/memberId"
          }
        }
      },
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "$comment": "Names and syntactic role hints only \u2014 the symbol outline, not the semantics. Detail is in functions.json; interpretation is in analysis.json.stateModel."
    },
    "decorator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changeDetection": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Default",
            "OnPush",
            null
          ]
        },
        "encapsulation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Emulated",
            "None",
            "ShadowDom",
            null
          ]
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hostDirectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "animations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tsLineCount": {
          "type": "integer",
          "minimum": 0
        },
        "templateLineCount": {
          "type": "integer",
          "minimum": 0
        },
        "methodCount": {
          "type": "integer",
          "minimum": 0
        },
        "publicApiSurface": {
          "$comment": "Count of members a PARENT can address: inputs + outputs + twoWayBindings + publicMethods. Deliberately excludes public fields the template reads -- those are internal consumption, not a contract with a parent, and counting them made the baseline and the extractor disagree 2 against 0 with neither being wrong (F8b).",
          "type": "integer",
          "minimum": 0
        },
        "injectedDependencyCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxCyclomaticComplexity": {
          "type": "integer",
          "minimum": 0
        },
        "maxTemplateNestingDepth": {
          "$comment": "Deepest nesting of elements and control-flow blocks in the template AST, root = 0. NULL when no template was parsed. Previously emitted as 0, which claims a measurement that was never taken -- a flat template and an unparsed one must not look identical (F8b).",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unreachableMethodCount": {
          "type": "integer",
          "minimum": 0
        },
        "effectivelyUnusedDependencyCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "generatedAt",
        "parseStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/provenanceSource"
        },
        "resolverVersion": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "inputHash": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "parseStatus": {
          "$ref": "common.schema.json#/$defs/parseStatus"
        },
        "warnings": {
          "$ref": "common.schema.json#/$defs/warningList"
        }
      },
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "$comment": "This tier is 100% deterministic \u2014 no LLM output. It must be byte-reproducible from unchanged source, which is what makes it cacheable and golden-testable."
    }
  },
  "patternProperties": {
    "^\\$comment": {
      "type": "string"
    }
  }
}
