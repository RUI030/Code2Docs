{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2docs/schema/functions.schema.json",
  "title": "functions.json -- detail tier (TypeScript side)",
  "$comment": "Validated against one hand-filled instance (examples/schema-probe/activate) rather than extractor output -- it needed no corrections, which is weaker evidence than it sounds: one small component with a single method exercises little of this tier. forms, batching and multi-symbol ordering remain untested. Keyed by symbol id rather than an array because random access is the point. Each entry splits `ast` (deterministic, cacheable, golden-testable) from `doc` (LLM-written, re-tunable) so the two invalidate independently. [tier] DETAIL TIER for the TypeScript side (your function_dict, with comments). Keyed by symbol id so an agent can jump straight to one function without reading the rest \u2014 this is the random-access property that makes the set feel IDE-like. Usually the largest file. Each entry splits `ast` (deterministic, from the Resolver) from `doc` (LLM-written); keeping them separate is what lets `ast` stay cacheable and golden-testable while `doc` is re-tunable. Also carries forms and stream detail, which are TS-side and too voluminous for the hot tier. Strict JSON; annotations use $comment keys.",
  "type": "object",
  "required": [
    "schemaVersion",
    "unitId",
    "symbols",
    "provenance"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^\\$comment": {
      "type": "string"
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "0.5.0",
      "$comment": "0.5.0 makes provenance.warnings structured objects with a closed code vocabulary and requires a computed parseStatus; 0.4.0 carried free prose that mixed designed gaps with real degradations, so nothing downstream could tell them apart."
    },
    "unitId": {
      "$ref": "common.schema.json#/$defs/unitId"
    },
    "callGraph": {
      "$comment": "Intra-class call graph: method:X → [method:Y, ...] for each this.Y() call found in X's body. Only methods with at least one intra-class callee appear as keys. A method absent from all value lists and not bound in the template is a dead-code candidate (D11 q:1).",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/memberId" },
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "common.schema.json#/$defs/memberId" }
      }
    },
    "symbols": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/memberId"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "ast"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "ast": {
            "type": "object",
            "required": [
              "id",
              "name",
              "loc"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/memberId"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "symbolKind": {
                "type": "string",
                "enum": [
                  "method",
                  "accessor",
                  "constructor"
                ]
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "protected",
                  "private"
                ]
              },
              "static": {
                "type": "boolean"
              },
              "isAsync": {
                "type": "boolean"
              },
              "lifecycleHook": {
                "$ref": "common.schema.json#/$defs/nullableString"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^\\$comment": {
                      "type": "string"
                    }
                  },
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "optional": {
                      "type": "boolean"
                    },
                    "defaultExpression": {
                      "$ref": "common.schema.json#/$defs/nullableString"
                    }
                  }
                }
              },
              "returnType": {
                "type": "string"
              },
              "isLeaf": {
                "type": "boolean"
              },
              "cyclomaticComplexity": {
                "$comment": "1 + one per branch point, counting exactly: if, ternary, each case clause, for/for-of/for-in, while, do-while, catch, and the && || ?? operators. Optional chaining and switch's default clause do not count. Enumerated because two correct implementations otherwise differ and the number is useless as a recall signal (F8b).",
                "type": "integer",
                "minimum": 1
              },
              "lineCount": {
                "type": "integer",
                "minimum": 0
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              },
              "sourceExcerpt": {
                "$comment": "Null by default. `loc` already points at the body, so carrying the text duplicates the source and can drift from it. Opt in with --source-excerpt when a consumer genuinely cannot open the file.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "existingComments": {
                "$comment": "What the original developer wrote. High-signal, and must never be confused with generated prose -- which is why it lives in ast, not doc. Comments the original developer wrote. High-signal and must never be confused with generated prose.",
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^\\$comment": {
                    "type": "string"
                  }
                },
                "properties": {
                  "jsDoc": {
                    "$ref": "common.schema.json#/$defs/nullableString"
                  },
                  "inline": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "sideEffectHints": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^\\$comment": {
                    "type": "string"
                  }
                },
                "properties": {
                  "touchesDom": {
                    "type": "boolean"
                  },
                  "domApis": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "subscribes": {
                    "type": "boolean"
                  },
                  "usesTimers": {
                    "type": "boolean"
                  },
                  "usesLocalOrSessionStorage": {
                    "type": "boolean"
                  },
                  "navigates": {
                    "type": "boolean"
                  },
                  "mutatesInjectedServiceState": {
                    "type": "boolean"
                  },
                  "throws": {
                    "type": "boolean"
                  },
                  "hasTryCatch": {
                    "type": "boolean"
                  }
                },
                "$comment": "Syntactic detection of constructs that commonly resist a naive framework migration."
              },
              "subscriptions": {
                "$comment": "Streams built and subscribed inline within this symbol (D12a). No id: the source gives them no name, and an invented one is not reproducible by extraction. `index` orders them within this symbol only -- it is deliberately not citable as evidence, so renumbering it cannot dangle a reference.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "index"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^\\$comment": {
                      "type": "string"
                    }
                  },
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sourceExpression": {
                      "type": "string"
                    },
                    "operators": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "consumption": {
                      "type": "string",
                      "enum": [
                        "explicit-subscribe",
                        "async-pipe",
                        "toSignal",
                        "firstValueFrom",
                        "none"
                      ]
                    },
                    "unsubscribeStrategy": {
            "$ref": "common.schema.json#/$defs/unsubscribeStrategy"
          },
                    "loc": {
                      "$ref": "common.schema.json#/$defs/loc"
                    }
                  }
                }
              }
            }
          },
          "doc": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "explanation": {
                "type": "string"
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "consumes": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/anyId"
                }
              },
              "produces": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/anyId"
                }
              },
              "sideEffects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "edgeCases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "isTrivial": {
                "type": "boolean"
              },
              "batchedWith": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/memberId"
                }
              },
              "confidence": {
                "$ref": "common.schema.json#/$defs/confidence"
              },
              "evidence": {
                "$ref": "common.schema.json#/$defs/evidenceList"
              },
              "explainerVersion": {
                "type": "string"
              }
            },
            "$comment": "Explainer output. Written in execution order (leaf-first) so callees are already explained."
          }
        }
      },
      "$comment": "Object keyed by symbol id, not an array \u2014 random access is the point."
    },
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "approach": {
          "type": "string",
          "enum": [
            "reactive",
            "template-driven",
            "mixed",
            "none"
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^form:[A-Za-z_$][A-Za-z0-9_$]*$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "builtWith": {
                "$comment": "Closed to what the extractor can actually recognise, and nullable so an unrecognised construction is recorded as 'not determined' plus a warning rather than as a guess. A free string here would let a half-matched heuristic write a plausible wrong value.",
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "FormBuilder",
                  "new FormGroup",
                  null
                ]
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "patternProperties": {
                    "^\\$comment": {
                      "type": "string"
                    }
                  },
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "control",
                        "group",
                        "array",
                        "record"
                      ],
                      "$comment": "AUTHORITATIVE for what kind of control this is: functions.json owns the control tree, so this is the vocabulary other tiers follow. 'record' added because FormRecord exists in 17.3.9 and was representable in signature's roleHints.formKind but not here -- one concept spelled two ways, which is how a fact ends up recordable in one tier and not the other (F10e)."
                    },
                    "valueType": {
                      "type": "string"
                    },
                    "initialValueExpression": {
                      "$ref": "common.schema.json#/$defs/nullableString"
                    },
                    "syncValidators": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "asyncValidators": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "disabledExpression": {
                      "$ref": "common.schema.json#/$defs/nullableString"
                    },
                    "updateOn": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "change",
                        "blur",
                        "submit",
                        null
                      ]
                    },
                    "boundTo": {
                      "$ref": "common.schema.json#/$defs/templateNodeId"
                    },
                    "id": {
                      "$ref": "common.schema.json#/$defs/formControlId"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              },
              "crossFieldValidators": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "submitHandler": {
                "$ref": "common.schema.json#/$defs/memberId"
              },
              "resetHandler": {
                "$ref": "common.schema.json#/$defs/memberId"
              },
              "patchedBy": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/callSiteId"
                }
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            }
          }
        },
        "ngModelBindings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/templateNodeId"
          }
        }
      }
    },
    "streams": {
      "$comment": "Declaration detail of a SOURCE-NAMED stream (D12 + D12a). Inline subscriptions are not here; they have no id and live on the symbol that subscribes them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stream:[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "declaredType": {
            "type": "string"
          },
          "sourceExpression": {
            "type": "string"
          },
          "operators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "multicast": {
            "type": "boolean"
          },
          "loc": {
            "$ref": "common.schema.json#/$defs/loc"
          },
          "doc": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "explanation": {
                "type": "string"
              },
              "confidence": {
                "$ref": "common.schema.json#/$defs/confidence"
              }
            }
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/memberId"
          },
          "signalKind": {
            "type": "string",
            "enum": [
              "signal",
              "computed",
              "linkedSignal",
              "toSignal"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/memberId"
            }
          },
          "writtenBy": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/callSiteId"
            }
          }
        }
      }
    },
    "tests": {
      "$comment": "Behavioral ground truth -- the one place the codebase states intent rather than mechanism. This tier owns test:<n> ids, which is why analysis.json falls back to bare titles when functions.json was not produced. Behavioral ground truth. The one place the codebase states intent rather than mechanism, so it both grounds explanations and contradicts wrong ones.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "framework": {
          "type": "string",
          "enum": [
            "jest",
            "jasmine-karma",
            "vitest",
            "unknown"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^test:[0-9]+$"
              },
              "suitePath": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/memberId"
                }
              },
              "mocks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "isSkipped": {
                "type": "boolean"
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "symbolsTotal": {
          "type": "integer",
          "minimum": 0
        },
        "symbolsExplained": {
          "type": "integer",
          "minimum": 0
        },
        "symbolsTrivialSkipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "$comment": "Two cache keys, because the halves invalidate independently: editing source invalidates ast, changing the prompt or model invalidates doc only. Two cache keys, because the tiers invalidate independently: editing source invalidates ast; changing the prompt or model invalidates doc only.",
      "type": "object",
      "required": [
        "generatedAt",
        "parseStatus"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/provenanceSource"
        },
        "astInputHash": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "docInputHash": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "resolverVersion": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "explainerModel": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "warnings": {
          "$ref": "common.schema.json#/$defs/warningList"
        },
        "parseStatus": {
          "$ref": "common.schema.json#/$defs/parseStatus"
        }
      }
    }
  }
}
