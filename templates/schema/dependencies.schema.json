{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code2docs/schema/dependencies.schema.json",
  "title": "dependencies.json -- graph tier",
  "$comment": "Answers 'what connects to what?'. Reverse indexes are emitted alongside forward ones because they are nearly free here and expensive for an agent to derive by scanning. Deterministic: no LLM output. [tier] GRAPH TIER \u2014 answers 'what connects to what?'. Covers both the in-file function call graph and cross-file edges. Reverse indexes (calledBy, readBy, consumedBy) are emitted alongside forward ones: they are nearly free here and expensive for an agent to derive by scanning, and they are what makes find-references feel instant. Strict JSON; annotations use $comment keys.",
  "type": "object",
  "required": [
    "schemaVersion",
    "unitId",
    "callGraph",
    "fieldAccess",
    "provenance"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^\\$comment": {
      "type": "string"
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/anyId"
      }
    },
    "memberList": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/memberId"
      }
    },
    "memberKeyedIdMap": {
      "$comment": "Keys are member ids; values are the ids they relate to. The integrity checker walks both.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/callSiteId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/idList"
      }
    },
    "importGroup": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "package": {
            "type": "string"
          },
          "resolvedUnitId": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/unitId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "callSiteList": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/callSiteId"
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": "0.5.0",
      "$comment": "0.5.0 makes provenance.warnings structured objects with a closed code vocabulary and requires a computed parseStatus; 0.4.0 carried free prose that mixed designed gaps with real degradations, so nothing downstream could tell them apart. 0.4.0 narrows streams to source-named only (D12a); 0.3.0 split the record across tiers (D12)."
    },
    "unitId": {
      "$ref": "common.schema.json#/$defs/unitId"
    },
    "callGraph": {
      "type": "object",
      "required": [
        "nodes",
        "calls",
        "calledBy",
        "entryPoints",
        "executionOrder"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "nodes": {
          "$ref": "#/$defs/memberList"
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "from": {
                "$comment": "A caller need not be a class member: a template binding calls in from outside the class. Same reasoning as callSiteId.",
                "$ref": "common.schema.json#/$defs/callSiteId"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/memberId"
              },
              "callCount": {
                "type": "integer",
                "minimum": 0
              },
              "conditional": {
                "type": "boolean"
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            }
          }
        },
        "calls": {
          "$ref": "#/$defs/memberKeyedIdMap"
        },
        "calledBy": {
          "$ref": "#/$defs/memberKeyedIdMap"
        },
        "entryPoints": {
          "$ref": "#/$defs/idList"
        },
        "executionOrder": {
          "$comment": "Leaf-first: the sequence the Explainer must follow so a caller is never reached before its callees are explained. A topological order is NOT unique, so the tiebreak is fixed: depth-first from each node in declaration order, emitting a node after its callees. Without a stated tiebreak two correct implementations disagree and the field cannot be diffed -- the same defect as the three metrics in F8b.",
          "$ref": "#/$defs/memberList"
        },
        "depthFromEntry": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/memberId"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "cycles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memberList"
          }
        },
        "unreachableMethods": {
          "$ref": "#/$defs/memberList"
        },
        "leafMethods": {
          "$ref": "#/$defs/memberList"
        }
      },
      "$comment": "In-file dependency graph over methods and accessors \u2014 the same-file function call dependency. executionOrder is leaf-first and is the sequence the Explainer must follow."
    },
    "fieldAccess": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "reads": {
          "$ref": "#/$defs/memberKeyedIdMap"
        },
        "writes": {
          "$ref": "#/$defs/memberKeyedIdMap"
        },
        "readBy": {
          "$ref": "#/$defs/memberKeyedIdMap"
        },
        "writtenBy": {
          "$ref": "#/$defs/memberKeyedIdMap"
        },
        "derivedFrom": {
          "$ref": "#/$defs/memberKeyedIdMap"
        },
        "signalDependencies": {
          "$ref": "#/$defs/memberKeyedIdMap"
        }
      },
      "$comment": "Data-flow side of the in-file graph. Both directions, for the same reason."
    },
    "dependencyUsage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dep"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "dep": {
            "type": "string",
            "pattern": "^dep:[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "resolvedUnitId": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/unitId"
              },
              {
                "type": "null"
              }
            ]
          },
          "calledMembers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "member"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^\\$comment": {
                  "type": "string"
                }
              },
              "properties": {
                "member": {
                  "type": "string",
                  "minLength": 1
                },
                "argTypes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "returnType": {
                  "type": "string"
                },
                "fromMethods": {
                  "$ref": "#/$defs/callSiteList"
                },
                "loc": {
                  "$ref": "common.schema.json#/$defs/loc"
                }
              }
            }
          },
          "readProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usedByMethods": {
            "$ref": "#/$defs/callSiteList"
          }
        }
      },
      "$comment": "How each injected dependency is actually exercised. Identity is in signature.json; this is the call detail."
    },
    "outboundUnitEdges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "targetUnitId",
          "relation"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "targetUnitId": {
            "$ref": "common.schema.json#/$defs/unitId"
          },
          "relation": {
            "$ref": "common.schema.json#/$defs/unitEdgeRelation"
          },
          "via": {
            "$ref": "#/$defs/idList"
          }
        }
      },
      "$comment": "Cross-unit edges, the basis for repo-level jump-to-definition. Mirrored as inboundUnitEdges by the repo indexer."
    },
    "inboundUnitEdges": {
      "$comment": "Mirrored by the repo indexer at Phase 2. Empty for a component-scoped run, which is honest degradation rather than a gap.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sourceUnitId",
          "relation"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "sourceUnitId": {
            "$ref": "common.schema.json#/$defs/unitId"
          },
          "relation": {
            "$ref": "common.schema.json#/$defs/unitEdgeRelation"
          },
          "via": {
            "$ref": "#/$defs/idList"
          }
        }
      }
    },
    "httpInteractions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "method"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^http:[0-9]+$"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "urlExpression": {
            "type": "string"
          },
          "requestType": {
            "$ref": "common.schema.json#/$defs/nullableString"
          },
          "responseType": {
            "$ref": "common.schema.json#/$defs/nullableString"
          },
          "viaDependency": {
            "type": "string",
            "pattern": "^dep:[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "calledFrom": {
            "$ref": "common.schema.json#/$defs/memberId"
          },
          "directHttpClientUse": {
            "type": "boolean"
          },
          "loc": {
            "$ref": "common.schema.json#/$defs/loc"
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "isRoutedComponent": {
          "type": "boolean"
        },
        "routePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routeParamsConsumed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "name": {
                "type": "string"
              },
              "access": {
                "type": "string",
                "enum": [
                  "snapshot",
                  "observable",
                  "withComponentInputBinding"
                ]
              },
              "inMethod": {
                "$ref": "common.schema.json#/$defs/memberId"
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            }
          }
        },
        "queryParamsConsumed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "name": {
                "type": "string"
              },
              "access": {
                "type": "string",
                "enum": [
                  "snapshot",
                  "observable",
                  "withComponentInputBinding"
                ]
              },
              "inMethod": {
                "$ref": "common.schema.json#/$defs/memberId"
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            }
          }
        },
        "routeDataConsumed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "navigations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^\\$comment": {
                "type": "string"
              }
            },
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^nav:[0-9]+$"
              },
              "api": {
                "$comment": "Closed: the extractor derives this from a fixed NAV_APIS set, so a free string could only ever hold one of these or a typo.",
                "type": "string",
                "enum": [
                  "router.navigate",
                  "router.navigateByUrl"
                ]
              },
              "targetExpression": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "loc": {
                "$ref": "common.schema.json#/$defs/loc"
              }
            }
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolvers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "imports": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "angular": {
          "$ref": "#/$defs/importGroup"
        },
        "rxjs": {
          "$ref": "#/$defs/importGroup"
        },
        "thirdParty": {
          "$ref": "#/$defs/importGroup"
        },
        "internal": {
          "$ref": "#/$defs/importGroup"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dataTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/typeId"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "declarationKind": {
            "type": "string",
            "enum": [
              "interface",
              "type-alias",
              "class",
              "enum",
              "unknown"
            ],
            "$comment": "'unknown' is the honest value for a type imported from another file: a single-file parse sees the reference, not the declaration. Phase 2's repo index resolves it. The predecessor claimed 'interface' for anything matching /^I[A-Z]/, which was a guess wearing an ast field (F8c)."
          },
          "definedHere": {
            "type": "boolean"
          },
          "sourceUnitId": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/unitId"
              },
              {
                "type": "null"
              }
            ]
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^\\$comment": {
                  "type": "string"
                }
              },
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                },
                "nullable": {
                  "type": "boolean"
                },
                "enumValues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "usedBy": {
            "$ref": "#/$defs/idList"
          }
        }
      }
    },
    "streams": {
      "$comment": "Relationship half of a SOURCE-NAMED stream (D12 + D12a). Declaration detail is in functions.json under the same id. leakRisk is absent by design: derivable from consumption and unsubscribeStrategy, and a stored derivation drifts from its inputs.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^\\$comment": {
            "type": "string"
          }
        },
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^stream:[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "consumedBy": {
            "$ref": "#/$defs/idList"
          },
          "consumption": {
            "type": "string",
            "enum": [
              "explicit-subscribe",
              "async-pipe",
              "toSignal",
              "firstValueFrom",
              "none"
            ]
          },
          "unsubscribeStrategy": {
            "$ref": "common.schema.json#/$defs/unsubscribeStrategy"
          },
          "subscribedFrom": {
            "$ref": "common.schema.json#/$defs/callSiteId"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "generatedAt",
        "parseStatus"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^\\$comment": {
          "type": "string"
        }
      },
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/provenanceSource"
        },
        "resolverVersion": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "inputHash": {
          "$ref": "common.schema.json#/$defs/nullableString"
        },
        "warnings": {
          "$ref": "common.schema.json#/$defs/warningList"
        },
        "parseStatus": {
          "$ref": "common.schema.json#/$defs/parseStatus"
        }
      }
    }
  }
}
