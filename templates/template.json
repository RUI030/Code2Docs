{
  "schemaVersion": "0.2.0",
  "$comment": "UI TIER — parsed template nodes AND the framework-independent UI requirements derived from them, co-located so UI work is a single read. Every node carries a stable tpl:<id> that uiRequirements cite as evidence. Read only when working on rendering; skipped entirely for services, pipes and guards. Strict JSON; annotations use $comment keys.",

  "unitId": "component:<path>:<ClassName>",
  "templateFile": "<foo.component.html, or null when inline>",

  "parse": {
    "$comment": "Template parsing is the weakest extractor and every UI requirement depends on it, so parse quality is reported rather than assumed. Never silently degrade.",
    "status": "<ok | partial | failed>",
    "parser": "<@angular/compiler | fallback-html>",
    "angularVersion": "<detected major>",
    "diagnostics": ["<message>"],
    "nodesParsed": 0,
    "nodesUnrecognized": 0
  },

  "ast": {
    "$comment": "Deterministic extraction from the template source.",

    "controlFlow": [
      {
        "id": "tpl:<id>",
        "construct": "<@if | @else if | @else | @for | @empty | @switch | @case | @default | @defer | @placeholder | @loading | @error | *ngIf | *ngFor | ngSwitch | *ngSwitchCase | *ngSwitchDefault>",
        "expression": "<condition or iterable expression as written>",
        "itemAlias": "<loop variable, or null>",
        "trackBy": "<track expression or trackBy fn, or null>",
        "aliases": ["<$index>", "<as vm>"],
        "dependsOn": ["field:<name>", "accessor:<name>"],
        "parent": "<tpl:<id>, or null>",
        "depth": 0,
        "loc": { "file": "<foo.component.html>", "line": 0, "endLine": 0 }
      }
    ],

    "propertyBindings": [
      { "id": "tpl:<id>", "target": "<element or component selector>", "property": "<disabled | ngClass | src>", "bindingKind": "<property | attribute | class | style | animation>", "expression": "<source text>", "dependsOn": ["field:<name>"], "loc": { "file": "<foo.component.html>", "line": 0 } }
    ],

    "eventBindings": [
      { "id": "tpl:<id>", "target": "<element or component selector>", "event": "<click | keydown.enter | customOutput>", "handlerExpression": "<source text>", "handlerMethod": "<method:<name>, or null>", "passesEvent": false, "loc": { "file": "<foo.component.html>", "line": 0 } }
    ],

    "twoWayBindings": [
      { "id": "tpl:<id>", "target": "<element>", "property": "<ngModel | value>", "expression": "<source text>", "boundField": "field:<name>", "loc": { "file": "<foo.component.html>", "line": 0 } }
    ],

    "interpolations": [
      { "id": "tpl:<id>", "expression": "<source text>", "pipes": ["<translate>", "<date:'short'>"], "dependsOn": ["field:<name>"], "loc": { "file": "<foo.component.html>", "line": 0 } }
    ],

    "childComponents": [
      {
        "id": "tpl:<id>",
        "selector": "<app-child>",
        "resolvedUnitId": "<component:...:ChildComponent, or null>",
        "inputsPassed": [{ "name": "<childInput>", "expression": "<source text>" }],
        "outputsHandled": [{ "name": "<childOutput>", "handlerExpression": "<source text>", "handlerMethod": "<method:<name>, or null>" }],
        "loc": { "file": "<foo.component.html>", "line": 0 }
      }
    ],

    "directivesUsed": [
      { "selector": "<appHighlight | routerLink | ngbTooltip>", "origin": "<angular | third-party | internal>", "resolvedUnitId": "<directive:..., or null>", "inputsPassed": [{ "name": "<x>", "expression": "<source text>" }], "occurrences": ["tpl:<id>"] }
    ],

    "pipesUsed": [
      { "name": "<translate>", "origin": "<angular | third-party | internal>", "resolvedUnitId": "<pipe:..., or null>", "isPure": true, "occurrences": ["tpl:<id>"] }
    ],

    "templateRefs": [
      { "id": "tpl:<id>", "name": "<myRef>", "onElement": "<element or component selector>", "referencedBy": ["query:<propertyName>", "tpl:<id>"] }
    ],

    "ngTemplates": [
      { "id": "tpl:<id>", "name": "<tmplName>", "contextKeys": ["<key>"], "instantiatedBy": ["tpl:<id>"] }
    ],

    "contentProjection": [
      { "id": "tpl:<id>", "select": "<[header], or null for the default slot>" }
    ],

    "viewQueries": [
      {
        "$comment": "Declared in TS but only meaningful against the template, so kept with the UI tier.",
        "id": "query:<propertyName>",
        "propertyName": "<propertyName>",
        "queryType": "<ViewChild | ViewChildren | ContentChild | ContentChildren>",
        "declarationStyle": "<decorator | signal>",
        "selector": "<template ref name | ComponentClass | DirectiveClass>",
        "read": "<read token, or null>",
        "static": false,
        "resolvesTo": "<tpl:<id>, or null>",
        "loc": { "file": "<foo.component.ts>", "line": 0 }
      }
    ],

    "hostBindings": [
      { "id": "hostbind:<n>", "attribute": "<class.active | attr.role | style.width>", "expression": "<source text>", "loc": { "file": "<foo.component.ts>", "line": 0 } }
    ],
    "hostListeners": [
      { "id": "hostlisten:<n>", "event": "<document:click>", "handler": "<source text>", "args": ["$event"], "loc": { "file": "<foo.component.ts>", "line": 0 } }
    ],

    "accessibility": [
      { "id": "tpl:<id>", "target": "<element>", "attributes": { "role": "<button>", "aria-label": "<source text>" }, "isInteractiveNonSemantic": false }
    ],

    "i18n": [
      { "id": "tpl:<id>", "mechanism": "<i18n-attr | translate-pipe | translate-directive>", "key": "<translation.key>", "params": ["<paramName>"] }
    ],

    "rawHtmlSinks": [
      { "id": "tpl:<id>", "property": "<innerHTML>", "expression": "<source text>", "sanitizerBypassed": false }
    ],

    "styles": {
      "files": ["<foo.component.scss>"],
      "encapsulation": "<Emulated | None | ShadowDom>",
      "usesEncapsulationEscapes": false,
      "escapeSelectors": ["<::ng-deep .foo>"],
      "usesHostSelectors": false,
      "importsGlobalStyles": ["<../../shared.scss>"],
      "classesToggledFromTs": ["<is-active>"]
    }
  },

  "uiRequirements": [
    {
      "$comment": "Framework-independent statements of rendering behavior. Prose is stored finished so requirement.md renders mechanically. Every entry must cite tpl:<id> evidence that exists in ast above.",
      "id": "ui:<n>",
      "category": "<structure | visibility | list | text | form | interaction | loading | error | navigation | accessibility | i18n>",
      "statement": "<e.g. 'The delete button is shown only when the current user holds ROLE_ADMIN.'>",
      "evidence": ["tpl:<id>"],
      "confidence": "<high | medium | low>"
    }
  ],

  "coverage": {
    "$comment": "Template nodes with no corresponding UI requirement are the primary eval signal for this tier.",
    "nodesTotal": 0,
    "nodesCoveredByRequirements": 0,
    "uncoveredNodeIds": ["tpl:<id>"]
  },

  "provenance": {
    "astInputHash": "<hash of template + styles + resolverVersion>",
    "docInputHash": "<astInputHash + synthesizerVersion>",
    "resolverVersion": "<semver>",
    "generatedAt": "<ISO-8601 UTC>"
  }
}
